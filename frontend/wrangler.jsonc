{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capitec-loan-simulator",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
